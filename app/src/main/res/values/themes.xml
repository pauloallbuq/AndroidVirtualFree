<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AVF" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorPrimary">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="GoldButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/btn_gold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">44dp</item>
    </style>
    <style name="OutlineButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">40dp</item>
    </style>
</resources>
